rules_version = '2';

// 러너리 Firestore 보안 규칙.
// 원칙: 모든 데이터는 기본적으로 막고, 아래에 적은 것만 허용합니다. 규칙을 임의로 완화하지 않습니다.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validId(id) {
      return id.matches('^[a-z0-9_]{4,16}$');
    }

    // 이메일 인증을 마친 계정이거나 소셜(카카오) 계정인지(로그인 증표에 적혀 있습니다).
    // 소셜 계정의 로그인 증표는 우리 서버 함수(kakaoLogin)만 만들 수 있어 'custom'이면 확인을 거친 계정입니다.
    function verified() {
      return request.auth.token.email_verified == true
        || request.auth.token.firebase.sign_in_provider == 'custom';
    }

    // [uid]의 친구인지(친구 목록에 내가 적혀 있는지).
    function isFriendOf(uid) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid));
    }

    function optionalNumber(d, key) {
      return !(key in d) || (d[key] is number && d[key] >= 0 && d[key] <= 1000000);
    }

    function optionalText(d, key) {
      return !(key in d) || (d[key] is string && d[key].size() <= 100);
    }

    // 친구에게 공유한 러닝 요약의 모양. 정확한 좌표는 없고 0~1000으로 줄인 경로 모양만 있습니다.
    function validPost(d) {
      return d.keys().hasOnly(['startedAt', 'distanceKm', 'movingSeconds', 'paceSeconds',
          'kcal', 'hetbahn', 'area', 'startPlace', 'endPlace', 'shape', 'route', 'sharedAt'])
        && d.keys().hasAll(['startedAt', 'distanceKm', 'shape', 'sharedAt'])
        && d.startedAt is timestamp
        && d.distanceKm is number && d.distanceKm >= 0 && d.distanceKm <= 1000
        && optionalNumber(d, 'movingSeconds')
        && optionalNumber(d, 'paceSeconds')
        && optionalNumber(d, 'kcal')
        && optionalNumber(d, 'hetbahn')
        && optionalText(d, 'area')
        && optionalText(d, 'startPlace')
        && optionalText(d, 'endPlace')
        && d.shape is list && d.shape.size() <= 400
        // 지도 경로: 경로 지도를 공개했을 때만, 출발·도착 근처를 자른 위도·경도 150쌍까지.
        && (!('route' in d) || (d.route is list && d.route.size() <= 300))
        && d.sharedAt == request.time;
    }

    function validShareSettings(d) {
      return d.keys().hasOnly(['autoShare', 'showTime', 'showPace', 'showKcal', 'showFood', 'showRoute'])
        && d.keys().hasAll(['autoShare', 'showTime', 'showPace', 'showKcal', 'showFood'])
        && d.autoShare is bool
        && d.showTime is bool
        && d.showPace is bool
        && d.showKcal is bool
        && d.showFood is bool
        && (!('showRoute' in d) || d.showRoute is bool);
    }

    // 러닝 기록 문서의 모양. 기록 본문(경로 등)은 압축한 덩어리(payload) 하나로 올라오고,
    // 지운 기록은 문서를 지우지 않고 deleted 표시만 남깁니다.
    function validRecordDoc(d) {
      return d.version == 1
        && d.updatedAt == request.time
        && d.deleted is bool
        && (d.deleted
          ? d.keys().hasOnly(['version', 'deleted', 'updatedAt'])
          : (d.keys().hasOnly(['version', 'deleted', 'updatedAt', 'startedAt', 'distanceKm', 'payload'])
            && d.keys().hasAll(['version', 'deleted', 'updatedAt', 'startedAt', 'distanceKm', 'payload'])
            && d.startedAt is timestamp
            && d.distanceKm is number
            && d.payload is bytes
            && d.payload.size() <= 950000));
    }

    // 프로필 문서의 모양. 앱이 저장하는 값만 허용합니다.
    // mateName은 룸메이트(캐릭터) 이름으로, 처음에는 없고 사용자가 정하면 생깁니다.
    // 앱은 5글자까지 받고, 이모지처럼 한 글자가 여러 칸인 경우를 생각해 서버는 20칸까지 허용합니다.
    function validProfile(d) {
      return d.keys().hasOnly(['name', 'email', 'id', 'age', 'gender', 'weightKg', 'createdAt', 'mateName'])
        && d.keys().hasAll(['name', 'email', 'id', 'age', 'gender', 'weightKg', 'createdAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 30
        && d.email is string && d.email.size() <= 254
        && d.id is string && validId(d.id)
        && d.age is int && d.age >= 1 && d.age <= 120
        && d.gender in ['여성', '남성', '선택 안 함']
        && d.weightKg is number && d.weightKg >= 20 && d.weightKg <= 300
        && (!('mateName' in d) || (d.mateName is string && d.mateName.size() >= 1 && d.mateName.size() <= 20));
    }

    // 사용자 프로필: 본인만 읽고 쓸 수 있습니다.
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;

      // 가입할 때: 프로필의 아이디는 같은 요청에서 차지한 아이디여야 합니다.
      allow create: if isOwner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.id)).data.uid == uid;

      // 수정할 때: 가입일과 이메일은 바꿀 수 없고, 새 아이디도 같은 요청에서 차지해야 합니다.
      allow update: if isOwner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.email == resource.data.email
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.id)).data.uid == uid;

      allow delete: if false;

      // 러닝 기록: 이메일 인증을 마친 본인만 읽고 쓸 수 있습니다. 문서는 지우지 않습니다.
      match /records/{recordId} {
        allow get, list: if isOwner(uid) && verified();
        allow create, update: if isOwner(uid)
          && verified()
          && recordId.matches('^[a-zA-Z0-9_-]{1,100}$')
          && validRecordDoc(request.resource.data);
        allow delete: if false;
      }

      // 친구에게 공유한 러닝: 본인과 친구만 읽고, 본인만 올리고 내립니다.
      match /posts/{recordId} {
        allow get, list: if (isOwner(uid) || isFriendOf(uid)) && verified();
        allow create, update: if isOwner(uid)
          && verified()
          && recordId.matches('^[a-zA-Z0-9_-]{1,100}$')
          && validPost(request.resource.data);
        allow delete: if isOwner(uid);

        // 응원: 문서 이름은 응원한 사람의 uid. 친구만 자기 응원을 남기고 지우며,
        // 기록 주인은 공유를 취소할 때 받은 응원을 지울 수 있습니다.
        match /cheers/{cheererUid} {
          allow get, list: if (isOwner(uid) || isFriendOf(uid)) && verified();
          allow create, update: if signedIn()
            && verified()
            && request.auth.uid == cheererUid
            && isFriendOf(uid)
            && exists(/databases/$(database)/documents/users/$(uid)/posts/$(recordId))
            && request.resource.data.keys().hasOnly(['clap', 'fire', 'muscle', 'updatedAt'])
            && request.resource.data.keys().hasAll(['clap', 'fire', 'muscle', 'updatedAt'])
            && request.resource.data.clap is bool
            && request.resource.data.fire is bool
            && request.resource.data.muscle is bool
            && request.resource.data.updatedAt == request.time;
          allow delete: if isOwner(uid) || (signedIn() && request.auth.uid == cheererUid);
        }
      }

      // 본인만 읽고 쓰는 설정: 기록 공유 설정(share).
      // 예전 주간 목표(goal)·랭킹 합계(stats)는 2026-11-27에 기능을 없애 더 이상 쓰지 못합니다.
      match /settings/{name} {
        allow get: if isOwner(uid) && verified();
        allow list: if false;
        allow create, update: if isOwner(uid)
          && verified()
          && name == 'share'
          && validShareSettings(request.resource.data);
        allow delete: if isOwner(uid);
      }

      // 내가 차단한 사람. 본인만 읽고 쓰며, 내용은 차단한 시각뿐입니다.
      // 차단한 사람과는 친구 요청을 주고받지 못합니다(friendRequests 규칙).
      match /blocks/{otherUid} {
        allow get, list: if isOwner(uid) && verified();
        allow create: if isOwner(uid)
          && verified()
          && otherUid != uid
          && request.resource.data.keys().hasOnly(['since'])
          && request.resource.data.since == request.time;
        allow update: if false;
        allow delete: if isOwner(uid);
      }

      // 친구 목록: 본인만 읽습니다. 친구 요청을 수락할 때 양쪽 목록에 함께 적고(요청이 있어야 함),
      // 친구를 삭제할 때는 둘 중 누구든 양쪽에서 지울 수 있습니다. 내용은 친구가 된 시각뿐입니다.
      match /friends/{friendUid} {
        allow get, list: if isOwner(uid) && verified();
        allow create: if signedIn()
          && verified()
          && uid != friendUid
          && request.resource.data.keys().hasOnly(['since'])
          && request.resource.data.since == request.time
          && ((isOwner(uid)
              && exists(/databases/$(database)/documents/friendRequests/$(friendUid + '_' + uid)))
            || (request.auth.uid == friendUid
              && exists(/databases/$(database)/documents/friendRequests/$(uid + '_' + friendUid))));
        allow update: if false;
        allow delete: if isOwner(uid) || (signedIn() && request.auth.uid == friendUid);
      }
    }

    // 친구 찾기용 공개 정보. 이름·아이디·검색어만 있고 이메일·나이·체중은 없습니다.
    // 인증을 마친 사람은 읽고 찾을 수 있고(한 번에 20명까지), 본인 것만 자기 아이디로 쓸 수 있습니다.
    function validPublicProfile(uid, d) {
      return d.keys().hasOnly(['name', 'id', 'keywords'])
        && d.keys().hasAll(['name', 'id', 'keywords'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 30
        && d.id is string && validId(d.id)
        && d.keywords is list && d.keywords.size() <= 300
        && get(/databases/$(database)/documents/usernames/$(d.id)).data.uid == uid;
    }

    match /profiles/{uid} {
      allow get: if signedIn() && verified();
      allow list: if signedIn() && verified() && request.query.limit <= 20;
      allow create, update: if isOwner(uid)
        && verified()
        && validPublicProfile(uid, request.resource.data);
      allow delete: if isOwner(uid);
    }

    // 함께 달리기 약속. 참여자(members)만 읽습니다. 보낸 사람(host)만 만들고 취소하며,
    // 참여자는 자기 답(statuses)·대기실 표시(ready)·결과(results)만 바꾸고, 시작(startedAt)은 한 번만 적습니다.
    // 목표 거리(goalKm) 0은 '지금 바로 같이 뛰기'(목표 없이 자유롭게)입니다.
    function memberOk(m, i) {
      return m.size() <= i
        || m[i] == request.auth.uid
        || exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(m[i]));
    }

    function onlyMine(after, before) {
      return after.diff(before).affectedKeys().hasOnly([request.auth.uid]);
    }

    match /together/{id} {
      allow get, list: if signedIn()
        && verified()
        && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && verified()
        && request.resource.data.keys().hasOnly(['host', 'members', 'statuses', 'startsAt', 'goalKm', 'createdAt'])
        && request.resource.data.keys().hasAll(['host', 'members', 'statuses', 'startsAt', 'goalKm', 'createdAt'])
        && request.resource.data.host == request.auth.uid
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 2
        // 나를 포함해 5명까지(앱의 Together.maxMembers와 같습니다).
        && request.resource.data.members.size() <= 5
        && request.auth.uid in request.resource.data.members
        && memberOk(request.resource.data.members, 0)
        && memberOk(request.resource.data.members, 1)
        && memberOk(request.resource.data.members, 2)
        && memberOk(request.resource.data.members, 3)
        && memberOk(request.resource.data.members, 4)
        && request.resource.data.statuses is map
        && request.resource.data.statuses.size() == request.resource.data.members.size()
        && request.resource.data.statuses.keys().hasOnly(request.resource.data.members)
        && request.resource.data.statuses.values().hasOnly(['accepted', 'pending'])
        && request.resource.data.statuses[request.auth.uid] == 'accepted'
        && request.resource.data.startsAt is timestamp
        && request.resource.data.goalKm is int
        && request.resource.data.goalKm >= 0 && request.resource.data.goalKm <= 100
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn()
        && verified()
        && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['statuses', 'ready', 'startedAt', 'results'])
        // 답: 내 것만, 정해진 값으로.
        && onlyMine(request.resource.data.statuses, resource.data.statuses)
        && request.resource.data.statuses[request.auth.uid] in ['pending', 'accepted', 'declined']
        // 대기실 표시: 내 것만, 지금 시각으로(나갈 때는 지웁니다).
        && onlyMine(request.resource.data.get('ready', {}), resource.data.get('ready', {}))
        && (!(request.auth.uid in request.resource.data.get('ready', {}))
          || request.resource.data.ready[request.auth.uid] == request.time
          || request.resource.data.ready[request.auth.uid] == resource.data.get('ready', {}).get(request.auth.uid, null))
        // 시작: 수락한 사람만, 한 번만, 지금 시각으로.
        && (!('startedAt' in request.resource.data)
          || ('startedAt' in resource.data && request.resource.data.startedAt == resource.data.startedAt)
          || (!('startedAt' in resource.data)
            && request.resource.data.startedAt == request.time
            && resource.data.statuses[request.auth.uid] == 'accepted'))
        // 결과: 내 것만.
        && onlyMine(request.resource.data.get('results', {}), resource.data.get('results', {}))
        && (!(request.auth.uid in request.resource.data.get('results', {}))
          || validTogetherResult(request.resource.data.results[request.auth.uid]));

      allow delete: if signedIn() && resource.data.host == request.auth.uid;
    }

    function validTogetherResult(r) {
      return r is map
        && r.keys().hasOnly(['recordId', 'distanceKm', 'movingSeconds', 'kcal', 'finishedAt'])
        && r.keys().hasAll(['recordId', 'distanceKm', 'movingSeconds', 'kcal', 'finishedAt'])
        && r.recordId is string && r.recordId.size() <= 100
        && r.distanceKm is number && r.distanceKm >= 0 && r.distanceKm <= 1000
        && r.movingSeconds is int && r.movingSeconds >= 0
        && r.kcal is int && r.kcal >= 0
        && r.finishedAt is timestamp;
    }

    // 함께 달리는 동안의 실시간 상태(거리·시간·위치·지나간 길). 그 약속의 참여자만 읽고,
    // 약속을 수락한 본인만 자기 것을 씁니다. 달리기가 끝나면 본인이 지웁니다.
    // 지나간 길(route)은 '순서,위도,경도' 글자 목록입니다.
    function validLiveRun(d) {
      return d.keys().hasOnly(['distanceKm', 'movingSeconds', 'paused', 'lat', 'lng', 'route', 'updatedAt'])
        && d.keys().hasAll(['distanceKm', 'movingSeconds', 'paused', 'updatedAt'])
        && d.distanceKm is number && d.distanceKm >= 0 && d.distanceKm <= 1000
        && d.movingSeconds is int && d.movingSeconds >= 0 && d.movingSeconds <= 1000000
        && d.paused is bool
        && (!('lat' in d) || (d.lat is number && d.lat >= -90 && d.lat <= 90))
        && (!('lng' in d) || (d.lng is number && d.lng >= -180 && d.lng <= 180))
        && (!('route' in d) || (d.route is list && d.route.size() <= 5000))
        && d.updatedAt == request.time;
    }

    match /together/{id}/live/{uid} {
      allow get, list: if signedIn()
        && verified()
        && request.auth.uid in get(/databases/$(database)/documents/together/$(id)).data.members;

      allow create, update: if isOwner(uid)
        && verified()
        && get(/databases/$(database)/documents/together/$(id)).data.statuses[uid] == 'accepted'
        && validLiveRun(request.resource.data);

      allow delete: if isOwner(uid);
    }

    // 친구 요청. 문서 이름은 '보낸 uid_받는 uid'이고, 보낸 사람과 받는 사람만 읽고 지울 수 있습니다.
    // 이미 친구이거나, 찾을 수 없는(공개 정보가 없는) 사람, 어느 한쪽이 차단한 사람에게는 보낼 수 없습니다.
    match /friendRequests/{requestId} {
      allow get, list: if signedIn()
        && verified()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn()
        && verified()
        && request.resource.data.keys().hasOnly(['from', 'to', 'createdAt'])
        && request.resource.data.keys().hasAll(['from', 'to', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && requestId == request.auth.uid + '_' + request.resource.data.to
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.to))
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(request.resource.data.to))
        && !exists(/databases/$(database)/documents/users/$(request.resource.data.to)/blocks/$(request.auth.uid))
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocks/$(request.resource.data.to));
      allow update: if false;
      allow delete: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // 크루. 멤버(members)만 읽습니다. 들어오는 방법은 멤버가 보낸 초대(crewInvites)와 초대 코드(서버 함수 crewCode)이고
    // 최대 200명입니다.
    // 방장(owner)은 이름·공지를 바꾸고 멤버를 내보내며, 나갈 때 다른 멤버에게 방장을 넘깁니다(혼자면 크루를 지움).
    // 멤버는 마지막 메시지 요약(lastMessage)을 바꾸고, 자기 자신만 넣거나(초대가 있을 때) 뺄 수 있습니다.
    function crewDoc(id) {
      return get(/databases/$(database)/documents/crews/$(id));
    }

    function crewAfter(id) {
      return getAfter(/databases/$(database)/documents/crews/$(id));
    }

    function isCrewMember(id) {
      return signedIn() && request.auth.uid in crewDoc(id).data.members;
    }

    function crewKeys(after, before) {
      return after.diff(before).affectedKeys();
    }

    // [after]가 [before]에 [uid] 한 명만 더한 목록인지.
    function addsOnly(after, before, uid) {
      return after.size() == before.size() + 1
        && after.hasAll(before)
        && uid in after
        && !(uid in before);
    }

    // [after]가 [before]에서 [uid] 한 명만 뺀 목록인지.
    function removesOnly(after, before, uid) {
      return after.size() == before.size() - 1
        && before.hasAll(after)
        && uid in before
        && !(uid in after);
    }

    match /crews/{crewId} {
      allow get, list: if signedIn() && verified() && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && verified()
        && request.resource.data.keys().hasOnly(['name', 'owner', 'members', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'owner', 'members', 'createdAt'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 20
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn() && verified() && (
        // 메시지를 보낼 때: 마지막 메시지 요약만, 내 이름과 지금 시각으로.
        (request.auth.uid in resource.data.members
          && crewKeys(request.resource.data, resource.data).hasOnly(['lastMessage'])
          && request.resource.data.lastMessage.keys().hasOnly(['uid', 'text', 'at'])
          && request.resource.data.lastMessage.uid == request.auth.uid
          && request.resource.data.lastMessage.text is string
          && request.resource.data.lastMessage.text.size() <= 100
          && request.resource.data.lastMessage.at == request.time)
        // 방장이 공지를 쓰거나 지울 때.
        || (resource.data.owner == request.auth.uid
          && crewKeys(request.resource.data, resource.data).hasOnly(['notice'])
          && (!('notice' in request.resource.data)
            || (request.resource.data.notice.keys().hasOnly(['text', 'by', 'at'])
              && request.resource.data.notice.by == request.auth.uid
              && request.resource.data.notice.text is string
              && request.resource.data.notice.text.size() >= 1
              && request.resource.data.notice.text.size() <= 200
              && request.resource.data.notice.at == request.time)))
        // 초대를 받아 들어올 때: 나만 더하고, 초대가 있어야 하며, 200명까지.
        || (crewKeys(request.resource.data, resource.data).hasOnly(['members'])
          && addsOnly(request.resource.data.members, resource.data.members, request.auth.uid)
          && request.resource.data.members.size() <= 200
          && exists(/databases/$(database)/documents/crewInvites/$(crewId + '_' + request.auth.uid)))
        // 멤버가 나갈 때(방장이 아니면 나만 뺌).
        || (resource.data.owner != request.auth.uid
          && crewKeys(request.resource.data, resource.data).hasOnly(['members'])
          && removesOnly(request.resource.data.members, resource.data.members, request.auth.uid))
        // 방장이 나갈 때: 나를 빼고 남은 멤버에게 방장을 넘깁니다.
        || (resource.data.owner == request.auth.uid
          && crewKeys(request.resource.data, resource.data).hasOnly(['members', 'owner'])
          && removesOnly(request.resource.data.members, resource.data.members, request.auth.uid)
          && request.resource.data.owner in request.resource.data.members)
        // 방장이 다른 멤버를 내보낼 때(한 명씩).
        || (resource.data.owner == request.auth.uid
          && crewKeys(request.resource.data, resource.data).hasOnly(['members'])
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && resource.data.members.hasAll(request.resource.data.members)
          && request.auth.uid in request.resource.data.members)
      );

      // 혼자 남은 방장만 크루를 지웁니다.
      allow delete: if signedIn()
        && resource.data.owner == request.auth.uid
        && resource.data.members.size() == 1;

      // 멤버 정보: 들어온 시각·마지막으로 읽은 시각·알림 끄기. 멤버만 읽고, 본인만 바꿉니다.
      match /members/{uid} {
        allow get, list: if isCrewMember(crewId) && verified();
        allow create: if isOwner(uid)
          && verified()
          && request.auth.uid in crewAfter(crewId).data.members
          && request.resource.data.keys().hasOnly(['joinedAt', 'lastReadAt', 'muted'])
          && request.resource.data.joinedAt == request.time
          && request.resource.data.lastReadAt == request.time
          && request.resource.data.muted is bool;
        allow update: if isOwner(uid)
          && verified()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastReadAt', 'muted'])
          && (request.resource.data.lastReadAt == request.time
            || request.resource.data.lastReadAt == resource.data.lastReadAt)
          && request.resource.data.muted is bool;
        // 본인(나갈 때)이나 방장(내보낼 때)이 지웁니다.
        allow delete: if isOwner(uid)
          || (signedIn() && crewDoc(crewId).data.owner == request.auth.uid);
      }

      // 크루장이 내보낸 사람. 코드로는 다시 못 들어오고(서버 함수 crewCode가 확인), 앱에서는 읽지 않습니다.
      // 크루장이 내보낼 때 적고, 크루장이 지우거나 본인이 다시 초대를 받아 수락할 때 지웁니다.
      match /banned/{uid} {
        allow get, list: if false;
        allow create, update: if signedIn()
          && verified()
          && crewDoc(crewId).data.owner == request.auth.uid
          && uid != request.auth.uid
          && request.resource.data.keys().hasOnly(['by', 'at'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at == request.time;
        allow delete: if signedIn()
          && (crewDoc(crewId).data.owner == request.auth.uid
            || (isOwner(uid)
              && exists(/databases/$(database)/documents/crewInvites/$(crewId + '_' + uid))));
      }

      // 함께 달리기 모집(대기실). 멤버만 읽습니다. 열기·참여·색·준비·나가기·시작은 서버 함수 crewRun이
      // 규칙(한 사람 한 모집, 10명, 팀장이 나가면 닫힘)을 지키며 바꾸므로 앱에서는 쓰지 못합니다.
      match /runs/{runId} {
        allow get, list: if isCrewMember(crewId) && verified();
        allow write: if false;

        // 함께 달리는 동안의 실시간 상태(거리·시간·위치·지나간 길). 같은 모집에 참여한 사람만 읽고,
        // 출발한 모집의 참여자 본인만 자기 것을 씁니다. 다른 모집 사람에게는 보이지 않습니다.
        match /live/{uid} {
          allow get, list: if signedIn()
            && verified()
            && request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)/runs/$(runId)).data.members;
          allow create, update: if isOwner(uid)
            && verified()
            && request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)/runs/$(runId)).data.members
            && get(/databases/$(database)/documents/crews/$(crewId)/runs/$(runId)).data.status in ['started', 'ended']
            && validLiveRun(request.resource.data);
          allow delete: if isOwner(uid);
        }

        // 팀 기록에 남긴 각자의 지나간 길(출발·도착 200m는 잘라 냄). 팀이 끝나면 서버 함수만 씁니다.
        // 크루 멤버 누구나 '기록 보기'에서 봅니다.
        match /routes/{uid} {
          allow get, list: if isCrewMember(crewId) && verified();
          allow write: if false;
        }
      }

      // 채팅 메시지. 멤버만 읽고 씁니다. 고치거나 지우지 않습니다.
      // 함께 달리기 모집 안내(run)는 서버 함수만 남깁니다.
      // 들어옴(join)은 들어온 뒤의 멤버가, 나감(leave)은 나가기 전의 멤버가, 내보냄(kick)은 방장이 남깁니다.
      match /messages/{messageId} {
        allow get, list: if isCrewMember(crewId) && verified();
        allow create: if signedIn()
          && verified()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && (
            (request.resource.data.kind == 'text'
              && request.resource.data.keys().hasOnly(['uid', 'kind', 'text', 'createdAt'])
              && request.resource.data.text is string
              && request.resource.data.text.size() >= 1
              && request.resource.data.text.size() <= 1000
              && request.auth.uid in crewDoc(crewId).data.members)
            || (request.resource.data.kind == 'join'
              && request.resource.data.keys().hasOnly(['uid', 'kind', 'createdAt'])
              && request.auth.uid in crewAfter(crewId).data.members)
            || (request.resource.data.kind == 'leave'
              && request.resource.data.keys().hasOnly(['uid', 'kind', 'createdAt'])
              && request.auth.uid in crewDoc(crewId).data.members
              && !(request.auth.uid in crewAfter(crewId).data.members))
            || (request.resource.data.kind == 'kick'
              && request.resource.data.keys().hasOnly(['uid', 'kind', 'target', 'createdAt'])
              && crewDoc(crewId).data.owner == request.auth.uid
              && request.resource.data.target in crewDoc(crewId).data.members
              && !(request.resource.data.target in crewAfter(crewId).data.members))
          );
        allow update, delete: if false;
      }
    }

    // 지금 들어가 있는 크루 모집(서버 함수 crewRun만 씁니다). 본인만 읽습니다.
    match /crewRunners/{uid} {
      allow get: if isOwner(uid) && verified();
      allow list, write: if false;
    }

    // 크루 초대 코드 → 크루 번호. 서버 함수 crewCode만 쓰고 읽어서, 앱에서는 코드로 크루를 훑어볼 수 없습니다.
    // 지금 코드는 crews/{번호}.code에 있고(멤버만 읽음) 그것도 서버 함수만 바꿉니다.
    match /crewCodes/{code} {
      allow read, write: if false;
    }

    // 팀이 끝난 뒤 실시간 상태를 지울 차례(서버 함수 crewRunTick만 씁니다).
    match /crewLiveCleanup/{id} {
      allow read, write: if false;
    }

    // 크루 초대. 문서 이름은 '크루 번호_받는 uid'이고, 보낸 사람과 받는 사람만 읽고 지웁니다.
    // 크루 멤버가 자기 친구에게만 보내고, 이미 멤버이거나 나를 차단한 사람에게는 보낼 수 없습니다.
    match /crewInvites/{inviteId} {
      allow get, list: if signedIn()
        && verified()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn()
        && verified()
        && request.resource.data.keys().hasOnly(['crewId', 'crewName', 'from', 'to', 'createdAt'])
        && request.resource.data.keys().hasAll(['crewId', 'crewName', 'from', 'to', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && inviteId == request.resource.data.crewId + '_' + request.resource.data.to
        && request.auth.uid in crewDoc(request.resource.data.crewId).data.members
        && !(request.resource.data.to in crewDoc(request.resource.data.crewId).data.members)
        && request.resource.data.crewName == crewDoc(request.resource.data.crewId).data.name
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(request.resource.data.to))
        && !exists(/databases/$(database)/documents/users/$(request.resource.data.to)/blocks/$(request.auth.uid))
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // 신고. 인증을 마친 사람이 자기 이름으로 올리기만 하고, 앱에서는 아무도 읽거나 고치지 못합니다
    // (Firebase 관리 화면에서 확인). 사유는 앱의 ReportReason 이름, 내용은 300자까지입니다.
    match /reports/{reportId} {
      allow get, list, update, delete: if false;
      allow create: if signedIn()
        && verified()
        && request.resource.data.keys().hasOnly(['reporter', 'target', 'reason', 'detail', 'recordId', 'createdAt'])
        && request.resource.data.keys().hasAll(['reporter', 'target', 'reason', 'createdAt'])
        && request.resource.data.reporter == request.auth.uid
        && request.resource.data.target is string
        && request.resource.data.target.size() >= 1 && request.resource.data.target.size() <= 128
        && request.resource.data.target != request.auth.uid
        && request.resource.data.reason in ['abuse', 'inappropriate', 'fakeRecord', 'spam', 'other']
        && (!('detail' in request.resource.data)
          || (request.resource.data.detail is string && request.resource.data.detail.size() <= 300))
        && (!('recordId' in request.resource.data)
          || (request.resource.data.recordId is string && request.resource.data.recordId.size() <= 100))
        && request.resource.data.createdAt == request.time;
    }

    // 아이디 중복 확인용. 아이디 하나당 문서 하나이고 주인(uid)만 적혀 있습니다.
    match /usernames/{id} {
      // 가입 전에도 '이미 쓰는 아이디인지' 물어볼 수 있어야 하므로 한 건씩 읽는 것만 열어 둡니다.
      allow get: if validId(id);
      allow list: if false;

      // 자기 프로필의 아이디로 정한 것만 차지할 수 있습니다(아이디 선점 방지).
      allow create: if signedIn()
        && validId(id)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.id == id;

      allow update: if false;

      // 내 프로필이 더 이상 이 아이디를 쓰지 않을 때만 놓을 수 있습니다.
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.id != id;
    }
  }
}
